---
import { site } from '../data/profile';

interface Props {
  /** Show the RSS link (only once at least one post is published). */
  showRss?: boolean;
}

const { showRss = false } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap offset">
    <p>
      © {site.copyrightYear} {site.name}
      {
        showRss && (
          <>
            {' · '}
            <a href="/rss.xml">RSS</a>
          </>
        )
      }
    </p>
  </div>
</footer>

<style>
  p {
    margin: 0;
    padding-block: 0 2rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  a {
    color: inherit;
  }
</style>
