---
import { site } from '../data/profile';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const path = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Work', show: true },
  { href: '/writing/', label: 'Writing', show: posts.length > 0 },
  { href: '/about/', label: 'About', show: true },
  { href: '/resume/', label: 'Résumé', show: true },
].filter((item) => item.show);

const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Dark theme" title="Toggle dark theme" aria-pressed="false" hidden>
        <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 1.125rem;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    letter-spacing: 0.005em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    white-space: nowrap;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin: -0.375rem -0.375rem -0.375rem 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    align-self: center;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Narrow screens: keep the name, up to four nav items and the toggle on one row. */
  @media (max-width: 26em) {
    .header-inner {
      column-gap: 1rem;
    }

    nav {
      gap: 0.5rem;
    }

    ul {
      gap: 0.25rem 0.75rem;
    }
  }
</style>
