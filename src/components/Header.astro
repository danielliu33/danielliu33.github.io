---
import { site } from '../data/profile';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home', show: true },
  { href: '/work/', label: 'Work', show: true },
  { href: '/writing/', label: 'Writing', show: posts.length > 0 },
].filter((item) => item.show);

const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="site-name" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 0.25rem;
  }

  @media (min-width: 60em) {
    .header-inner {
      padding-block: 2rem 0.25rem;
    }
  }

  .site-name {
    font-size: 1.75rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.005em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
</style>
