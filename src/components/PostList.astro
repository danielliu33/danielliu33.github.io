---
/** Posts as a dated list: "2026 Oct | Title", optionally with the description below. */
import { formatMonth, isDraft, isoMonth, postHref, type Post } from '../lib/posts';
import { smart } from '../lib/typography';

interface Props {
  posts: Post[];
  showDescription?: boolean;
}

const { posts, showDescription = false } = Astro.props;
---

<ul class="dated">
  {
    posts.map((post) => (
      <li>
        <time class="date" datetime={isoMonth(post.data.date)}>
          {formatMonth(post.data.date)}
        </time>
        <span>
          <a class="title" href={postHref(post)}>
            {smart(post.data.title)}
          </a>
          {isDraft(post) && <span class="draft"> (draft)</span>}
          {showDescription && <span class="desc">{smart(post.data.description)}</span>}
        </span>
      </li>
    ))
  }
</ul>
