---
import { formatDate, isDraft, isoDate, postHref, type Post } from '../lib/posts';
import { smart } from '../lib/typography';

interface Props {
  posts: Post[];
  showDescription?: boolean;
  /** 2 when the list sits directly under the page <h1>, 3 under a section <h2>. */
  headingLevel?: 2 | 3;
}

const { posts, showDescription = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ul class="entries posts">
  {
    posts.map((post) => (
      <li class="entry">
        <p class="meta">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          {isDraft(post) && <span class="draft"> · Draft</span>}
        </p>
        <Heading class="entry-title">
          <a href={postHref(post)}>{smart(post.data.title)}</a>
        </Heading>
        {showDescription && <p class="entry-text">{smart(post.data.description)}</p>}
      </li>
    ))
  }
</ul>

<style>
  .posts .entry + .entry {
    margin-top: 1.75rem;
  }

  .draft {
    color: var(--accent);
  }
</style>
