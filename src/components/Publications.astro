---
import { publications, patents } from '../data/profile';
---

<ul class="entries pubs">
  {
    publications.map((p) => (
      <li class="entry">
        <p class="pub-title">
          <a href={p.url}>{p.title}</a>
        </p>
        <p class="meta">{p.authors}</p>
        <p class="meta">
          {p.venue} · {p.year}
        </p>
      </li>
    ))
  }
  {
    patents.map((p) => (
      <li class="entry">
        <p class="pub-title">
          <a href={p.url}>{p.title}</a>
        </p>
        <p class="detail">{p.detail}</p>
      </li>
    ))
  }
</ul>

<style>
  .pubs .entry + .entry {
    margin-top: 1.5rem;
  }

  .pub-title {
    margin: 0 0 0.25rem;
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .pub-title a {
    text-decoration-color: var(--accent-soft);
  }

  .pubs .meta {
    margin: 0;
  }

  .detail {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
