---
/**
 * Case studies as a dated list.
 * - home: "2026 | Built a multi-agent platform from zero. (write-up)"
 * - index (/work/): title link, then the organization and the case study's one-liner.
 */
import { getWork, workHref } from '../lib/work';
import { smart } from '../lib/typography';

interface Props {
  variant?: 'home' | 'index';
}

const { variant = 'home' } = Astro.props;
const work = await getWork();
---

<ul class:list={['dated', { 'dated-index': variant === 'index' }]}>
  {
    work.map((item) => (
      <li>
        <span class="date">{item.data.years}</span>
        {variant === 'home' ? (
          <span>
            {item.text}{' '}
            <a class="aux" href={workHref(item)}>
              (write-up)
            </a>
          </span>
        ) : (
          <span>
            <a class="title" href={workHref(item)}>
              {smart(item.data.title)}
            </a>
            <span class="desc">
              <span class="note">{item.data.org}.</span> {smart(item.data.one_liner)}
            </span>
          </span>
        )}
      </li>
    ))
  }
</ul>

<style>
  .desc {
    margin-bottom: 0.6rem;
  }
</style>
