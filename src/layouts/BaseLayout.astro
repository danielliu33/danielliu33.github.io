---
// Static EB Garamond (not a variable font): Chrome embeds variable fonts in
// PDFs as Type 3, which copy-pastes as garbled text, so the CV PDF needs these.
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '../styles/global.css';
import garamondLatin from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import katexCss from 'katex/dist/katex.min.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, twitter } from '../data/profile';
import { getPosts } from '../lib/posts';

interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description?: string;
  /** 'article' for posts and case studies. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Load KaTeX CSS (only pages that render math). */
  math?: boolean;
  noindex?: boolean;
  /** JSON-LD object to embed. */
  jsonLd?: Record<string, unknown>;
  /** Extra class on <main>, e.g. for the CV's print layout. */
  mainClass?: string;
}

const {
  title,
  description = site.metaDescription,
  type = 'website',
  publishedTime,
  modifiedTime,
  math = false,
  noindex = false,
  jsonLd,
  mainClass,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.name;
// noindex pages (404, the CV print source, the empty Writing index, drafts) get no canonical URL.
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site).href;
// Advertise the feed only once there is something in it.
const hasPosts = (await getPosts()).length > 0;
const ogImage = new URL('/og-default.png', Astro.site).href;
const rss = new URL('/rss.xml', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f4f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161615" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href={rss} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={garamondLatin} as="font" type="font/woff2" crossorigin />
    {math && <link rel="stylesheet" href={katexCss} />}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.headline}`} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {twitter && <meta name="twitter:creator" content={twitter.handle} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['wrap', mainClass]} tabindex="-1">
      <slot />
    </main>
    <Footer showRss={hasPosts} />
    <script is:inline>
      // Assemble obfuscated email links (see components/Email.astro).
      (function () {
        var nodes = document.querySelectorAll('[data-eu]');
        for (var i = 0; i < nodes.length; i++) {
          var el = nodes[i];
          var addr = el.getAttribute('data-eu') + '@' + el.getAttribute('data-ed');
          var a = document.createElement('a');
          a.href = 'mailto:' + addr;
          a.textContent = el.getAttribute('data-label') || addr;
          if (el.className) a.className = el.className;
          el.parentNode.replaceChild(a, el);
        }
      })();
    </script>
  </body>
</html>
