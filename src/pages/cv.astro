---
/**
 * CV print source. `npm run pdf` prints this page to public/cv.pdf (Letter,
 * at most 2 pages). Not linked from the nav and not in the sitemap: visitors
 * get the PDF. Content comes from `cv` in src/data/profile.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Email from '../components/Email.astro';
import CvEntry from '../components/CvEntry.astro';
import { site, links, twitter, cv } from '../data/profile';
---

<BaseLayout title="CV" description={`CV of ${site.name}. ${cv.summary}`} noindex mainClass="cv-main">
  {/* Printed footer from page 2 on: "Daniel Liu · 2 / 2" (Chrome 131+ prints @page margin boxes). */}
  <style
    is:inline
    set:html={`@page { @bottom-right { content: ${JSON.stringify(`${site.name} · `)} counter(page) " / " counter(pages); font: 9pt 'EB Garamond', serif; color: #444; } } @page :first { @bottom-right { content: none; } }`}
  />
  <article class="cv" aria-labelledby="cv-name">
    <header class="cv-head">
      <h1 id="cv-name">{site.name}</h1>
      <p class="cv-toolbar">
        <a href={links.cvPdf}>PDF</a> · <a href={links.cvPdf} download={links.cvFileName}>Download</a>
      </p>
      <p class="cv-contact">
        <span>{site.location}</span>
        <span><Email /></span>
        <span><a href={links.linkedin}>{links.linkedinLabel}</a></span>
        {
          twitter && (
            <span>
              <a href={twitter.url}>{twitter.label}</a>
            </span>
          )
        }
      </p>
      <p class="cv-summary">{cv.summary}</p>
    </header>

    {
      cv.sections.map((section, i) => (
        <section aria-labelledby={`cv-s${i}`}>
          <h2 id={`cv-s${i}`}>{section.title}</h2>
          {section.layout === 'inline' ? (
            <ul class="cv-inline">
              {section.entries.map((e) => (
                <li>
                  <span class="cv-strong">{e.heading}:</span> {e.subheading}
                </li>
              ))}
            </ul>
          ) : (
            section.entries.map((entry) => <CvEntry entry={entry} />)
          )}
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .cv {
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .cv-head {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    align-items: baseline;
  }

  .cv-head > :not(h1, .cv-toolbar) {
    grid-column: 1 / -1;
  }

  .cv-head h1 {
    font-size: 1.875rem;
    margin: 0 0 0.25rem;
  }

  .cv-toolbar {
    margin: 0;
    font-size: 0.9375rem;
    white-space: nowrap;
    color: var(--muted);
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    margin: 0 0 0.6rem;
    color: var(--ink-2);
  }

  .cv-contact > span {
    white-space: nowrap;
  }

  /* The separator trails each item, so a wrapped line never starts with "·". */
  .cv-contact > span:not(:last-child)::after {
    content: ' ·';
    content: ' ·' / '';
  }

  .cv-summary {
    margin: 0;
  }

  .cv h2 {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 1.6rem 0 0.6rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .cv :global(.cv-entry + .cv-entry) {
    margin-top: 0.7rem;
  }

  .cv :global(.cv-nested) {
    margin-left: 1rem;
  }

  .cv :global(.cv-entry > .cv-nested:first-of-type) {
    margin-top: 0.45rem;
  }

  .cv :global(.cv-nested + .cv-nested) {
    margin-top: 0.45rem;
  }

  .cv :global(.cv-line) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.1rem 1rem;
    margin: 0;
  }

  .cv :global(.cv-strong) {
    font-weight: 500;
  }

  .cv :global(a.cv-strong) {
    color: inherit;
  }

  .cv :global(.cv-years) {
    font-size: 0.9375rem;
    color: var(--ink-2);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .cv :global(.cv-sub-below) {
    margin: 0;
    font-style: italic;
  }

  .cv :global(ul) {
    margin: 0.2rem 0 0;
    padding-left: 1.1em;
  }

  .cv :global(li + li) {
    margin-top: 0.1rem;
  }

  .cv :global(li::marker) {
    color: var(--muted);
  }

  .cv-inline {
    list-style: none;
    padding-left: 0 !important;
  }

  @media (max-width: 34em) {
    .cv :global(.cv-line) {
      flex-direction: column;
    }
  }

  /* ---------- print: Letter, at most two pages ---------- */

  @page {
    size: letter;
    margin: 0.55in 0.7in 0.55in;
  }

  @media print {
    /* html:root outranks the :root tokens (and their dark-mode values) in global.css. */
    :global(html:root) {
      color-scheme: light;
      --bg: #ffffff;
      --bg-soft: #ffffff;
      --ink: #000000;
      --ink-2: #1a1a1a;
      --muted: #444444;
      --rule: #bdbdbd;
      --link: #000000;
    }

    :global(html),
    :global(html body) {
      background: #fff;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .cv-toolbar {
      display: none !important;
    }

    :global(main.cv-main) {
      padding: 0 !important;
      max-width: none !important;
    }

    .cv {
      font-size: 10.6pt;
      line-height: 1.28;
    }

    .cv-head {
      display: block;
    }

    .cv-head h1 {
      font-size: 20pt;
      margin: 0 0 1pt;
    }

    .cv-contact {
      margin: 0 0 4pt;
    }

    .cv-contact > span {
      white-space: normal;
    }

    .cv a,
    .cv :global(a) {
      color: inherit;
      text-decoration: none;
    }

    .cv h2 {
      font-size: 8.6pt;
      margin: 10pt 0 4pt;
      padding-bottom: 1.5pt;
      break-after: avoid;
    }

    .cv :global(.cv-entry + .cv-entry) {
      margin-top: 5pt;
    }

    .cv :global(.cv-nested) {
      margin-left: 10pt;
    }

    .cv :global(.cv-entry > .cv-nested:first-of-type),
    .cv :global(.cv-nested + .cv-nested) {
      margin-top: 3pt;
    }

    .cv :global(.cv-years) {
      font-size: 10pt;
    }

    .cv :global(ul) {
      margin-top: 1.5pt;
    }

    .cv :global(li + li) {
      margin-top: 0.5pt;
    }

    .cv :global(.cv-line),
    .cv :global(.cv-nested),
    .cv :global(li) {
      break-inside: avoid;
    }

    .cv :global(.cv-line) {
      break-after: avoid;
    }
  }
</style>
