---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Email from '../components/Email.astro';
import WorkList from '../components/WorkList.astro';
import PaperList from '../components/PaperList.astro';
import PostList from '../components/PostList.astro';
import { site, links, twitter, bio } from '../data/profile';
import { inlineParts } from '../lib/inline-links';
import { imageSize } from '../lib/image-size';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 8);

const photo = site.photo || null;
const photoFile = photo ? join(process.cwd(), 'public', photo) : null;
if (photoFile && !existsSync(photoFile)) {
  throw new Error(`site.photo is "${photo}" but public${photo} does not exist.`);
}
// Real dimensions, so the bio does not shift down while the photo loads.
const photoSize = photoFile ? imageSize(photoFile) : null;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url + '/',
  description: site.metaDescription,
  ...(photo ? { image: new URL(photo, site.url).href } : {}),
  sameAs: [links.linkedin, ...(twitter ? [twitter.url] : [])],
  knowsAbout: ['Post-training', 'Evaluation', 'AI agents', 'Ranking and recommendation systems'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Illinois Urbana-Champaign' },
};
---

<BaseLayout jsonLd={person}>
  <h1 class="sr-only">{site.name}</h1>

  <div class:list={['intro', { 'has-photo': photo }]}>
    {
      photo && photoSize && (
        <img
          class="photo"
          src={photo}
          alt=""
          width={photoSize.width}
          height={photoSize.height}
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    <div class="bio">
      {
        bio.map((paragraph) => (
          <p>{inlineParts(paragraph).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
        ))
      }
      <p class="links">
        {
          twitter && (
            <>
              <a href={twitter.url} rel="me">
                Twitter
              </a>
              <span class="slash" aria-hidden="true"> / </span>
            </>
          )
        }
        <a href={links.cvPdf}>CV</a>
        <span class="slash" aria-hidden="true"> / </span>
        <a href={links.linkedin} rel="me">LinkedIn</a>
        <span class="slash" aria-hidden="true"> / </span>
        <Email label="Email" />
      </p>
    </div>
  </div>

  <section class="section" aria-labelledby="work">
    <h2 id="work" class="section-title">Work</h2>
    <WorkList />
  </section>

  <section class="section" aria-labelledby="papers">
    <h2 id="papers" class="section-title">Papers &amp; patents</h2>
    <PaperList />
  </section>

  {
    latest.length > 0 && (
      <section class="section" aria-labelledby="writing">
        <h2 id="writing" class="section-title">Writing</h2>
        <PostList posts={latest} />
        {posts.length > latest.length && (
          <p class="section-more">
            <a href="/writing/">All writing</a>
          </p>
        )}
      </section>
    )
  }
</BaseLayout>

<style>
  .bio p {
    margin: 0 0 0.6em;
  }

  .bio .links {
    margin: 1.1em 0 0;
  }

  /* Larger tap targets on phones without changing the line height. */
  .bio .links a {
    padding-block: 0.35rem;
  }

  .slash {
    color: var(--muted);
  }

  .photo {
    display: block;
    width: 9rem;
    height: auto;
    margin: 0 0 1.25rem;
  }

  @media (min-width: 40em) {
    .intro.has-photo {
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: 1.75rem;
      align-items: start;
    }

    .intro.has-photo .photo {
      margin: 0.3em 0 0;
    }
  }

  /* Wide screens: the photo moves into the empty rail left of the text column. */
  @media (min-width: 60em) {
    .intro.has-photo {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: var(--rail-gap);
      margin-left: calc(-1 * (var(--rail) + var(--rail-gap)));
    }

    .intro.has-photo .photo {
      width: var(--rail);
    }
  }
</style>
