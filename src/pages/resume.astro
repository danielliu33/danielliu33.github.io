---
import BaseLayout from '../layouts/BaseLayout.astro';
// Static (non-variable) Newsreader for the PDF: Chrome embeds variable fonts as
// Type 3, which copy-pastes as garbled text in macOS Preview and some ATS parsers.
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-500.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/newsreader/latin-400-italic.css';
import Email from '../components/Email.astro';
import { site, links, resume, type LeadLine } from '../data/profile';

/** Split a trailing " · 2026" / " · 2020–2026" off a line so years can sit flush right. */
function splitYears(text: string): [string, string | null] {
  const i = text.lastIndexOf(' · ');
  if (i === -1) return [text, null];
  const tail = text.slice(i + 3);
  return /^\d{4}(–\d{4})?$/.test(tail) ? [text.slice(0, i), tail] : [text, null];
}

/** Split a trailing " · City, ST" off a line so the location wraps as one unit. */
function splitLocation(text: string): [string, string | null] {
  const i = text.lastIndexOf(' · ');
  if (i === -1) return [text, null];
  const tail = text.slice(i + 3);
  return /^[A-Z][A-Za-z .]+, [A-Z]{2}$/.test(tail) ? [text.slice(0, i), tail] : [text, null];
}

const head = (line: LeadLine) => {
  const [withLoc, years] = splitYears(line.rest);
  const [rest, loc] = splitLocation(withLoc);
  return { lead: line.lead, rest, loc, years };
};

const degrees = resume.education.heading.rest.split(' · ');
const skills = resume.skills.split(' · ');
const pdfName = `${site.name.replace(/\s+/g, '-')}-Resume.pdf`;
---

<BaseLayout title="Résumé" description={`Résumé of ${site.name}: ${resume.summary}`} mainClass="resume-main">
  <article class="resume" aria-labelledby="r-name">
    <header class="r-head">
      <h1 id="r-name">{site.name}</h1>
      <p class="r-toolbar"><a href={links.resumePdf} download={pdfName}>Download PDF</a></p>
      <p class="r-contact">
        <span>{site.location}</span>
        <span><span class="r-dot" aria-hidden="true">· </span><Email /></span>
        <span><span class="r-dot" aria-hidden="true">· </span><a href={links.linkedin}>{links.linkedinLabel}</a></span>
      </p>
      <p class="r-summary">{resume.summary}</p>
    </header>

    <section aria-labelledby="r-exp">
      <h2 id="r-exp">Experience</h2>
      {
        resume.experience.map((entry) => {
          const h = head(entry.heading);
          return (
            <div class="r-entry">
              <p class="r-line">
                <span>
                  <strong>{h.lead}</strong> — {h.rest}
                  {h.loc && (
                    <>
                      {' '}
                      <span class="r-loc">· {h.loc}</span>
                    </>
                  )}
                </span>
                {h.years && <span class="r-years">{h.years}</span>}
              </p>
              {entry.bullets && (
                <ul>
                  {entry.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              {entry.groups &&
                entry.groups.map((g) => {
                  const [title, years] = splitYears(g.title);
                  return (
                    <div class="r-group">
                      <p class="r-line r-sub">
                        <em>{title}</em>
                        {years && <span class="r-years">{years}</span>}
                      </p>
                      <ul>
                        {g.bullets.map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    </div>
                  );
                })}
            </div>
          );
        })
      }
      <div class="r-entry">
        <p class="r-plain"><strong>{resume.internships.lead}</strong> — {resume.internships.rest}</p>
      </div>
    </section>

    <section aria-labelledby="r-edu">
      <h2 id="r-edu">Education</h2>
      <div class="r-entry">
        <p class="r-plain">
          <strong>{resume.education.heading.lead}</strong>
          <span class="r-edu-dash">{' — '}</span>
          {degrees.map((d, i) => (
            <span class="r-degree">
              {i > 0 && <span class="r-degree-sep">· </span>}
              {d}{' '}
            </span>
          ))}
        </p>
        <ul>
          {resume.education.bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="r-pub">
      <h2 id="r-pub">Publications &amp; Patent</h2>
      <ul>
        {
          resume.publications.map((p) => (
            <li>
              {p.before}
              <a href={p.url}>{p.linkText}</a>
              {p.after}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="r-skills">
      <h2 id="r-skills">Skills</h2>
      <p class="r-plain r-skills">
        {skills.map((skill, i) => (
          <span class="r-skill">
            {skill}
            {i < skills.length - 1 && ' ·'}
          </span>
        ))}
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .r-head {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    align-items: baseline;
  }

  .r-head > :not(h1, .r-toolbar) {
    grid-column: 1 / -1;
  }

  .r-toolbar {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .resume {
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .r-head h1 {
    font-size: clamp(2rem, 1.7rem + 1.4vw, 2.5rem);
    letter-spacing: -0.012em;
    margin: 0 0 0.5rem;
  }

  .r-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.35em;
    margin: 0 0 0.875rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .r-contact > span {
    white-space: nowrap;
  }

  .r-contact :global(a) {
    color: var(--ink-2);
  }

  .r-loc {
    white-space: nowrap;
  }

  /* On screen each degree gets its own line; print keeps them on one. */
  .r-degree {
    display: block;
  }

  .r-degree-sep,
  .r-edu-dash {
    display: none;
  }

  .r-skills {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.3em;
  }

  .r-skill {
    white-space: nowrap;
  }

  .r-summary {
    margin: 0;
    color: var(--ink-2);
  }

  .resume h2 {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 2.25rem 0 0.875rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .r-entry + .r-entry {
    margin-top: 1.125rem;
  }

  .r-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .r-years {
    font-family: var(--sans);
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .r-plain {
    margin: 0;
  }

  .r-group {
    margin-top: 0.625rem;
  }

  .r-sub em {
    font-style: italic;
  }

  .resume ul {
    margin: 0.3rem 0 0;
    padding-left: 1.1em;
  }

  .resume li + li {
    margin-top: 0.2rem;
  }

  .resume li::marker {
    color: var(--muted);
  }

  .resume strong {
    font-weight: 550;
  }

  .resume a {
    text-decoration-color: var(--accent-soft);
  }

  @media (max-width: 34em) {
    .r-line {
      flex-direction: column;
    }
  }

  /* ---------- print: one Letter page ---------- */

  @page {
    size: letter;
    margin: 0.5in 0.6in 0.45in;
  }

  @media print {
    /* html:root outranks the :root tokens in global.css whatever the CSS order. */
    :global(html:root),
    :global(html:root[data-theme='dark']) {
      color-scheme: light;
      --bg: #ffffff;
      --bg-soft: #ffffff;
      --ink: #111111;
      --ink-2: #222222;
      --muted: #555555;
      --rule: #c9c9c9;
      --accent: #111111;
      --accent-soft: transparent;
    }

    :global(html:root) {
      --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
      --sans: Arial, 'Helvetica Neue', Helvetica, sans-serif;
    }

    :global(html body) {
      background: #fff;
      font-size: 10pt;
      line-height: 1.36;
      font-optical-sizing: none;
    }

    .resume strong {
      font-weight: 600;
    }

    .r-head {
      display: block;
    }

    .r-contact > span {
      white-space: normal;
    }

    .r-degree {
      display: inline;
    }

    .r-degree-sep,
    .r-edu-dash {
      display: inline;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .r-toolbar {
      display: none !important;
    }

    :global(main.resume-main) {
      padding: 0 !important;
      max-width: none !important;
    }

    .resume {
      font-size: 10pt;
      line-height: 1.36;
    }

    .r-head h1 {
      font-size: 21pt;
      margin: 0 0 2pt;
    }

    .r-contact {
      font-size: 8.4pt;
      margin: 0 0 5pt;
      color: #333;
    }

    .r-contact :global(a),
    .resume a {
      color: inherit;
      text-decoration: none;
    }

    .r-summary {
      color: #222;
    }

    .resume h2 {
      font-size: 7.6pt;
      margin: 10pt 0 5pt;
      padding-bottom: 2pt;
      color: #444;
    }

    .r-entry + .r-entry {
      margin-top: 5pt;
    }

    .r-group {
      margin-top: 3pt;
    }

    .resume ul {
      margin-top: 1.5pt;
    }

    .resume li + li {
      margin-top: 1pt;
    }

    .r-years {
      font-size: 8.2pt;
      color: #444;
    }

    .r-entry,
    .r-group,
    .resume li {
      break-inside: avoid;
    }
  }
</style>
