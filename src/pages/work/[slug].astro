---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWork, workHref, type WorkEntry } from '../../lib/work';
import { smart } from '../../lib/typography';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: work[i - 1], next: work[i + 1] },
  }));
}

interface Props {
  entry: WorkEntry;
  prev?: WorkEntry;
  next?: WorkEntry;
}

const { entry, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const title = smart(entry.data.title);
---

<BaseLayout title={title} description={smart(entry.data.one_liner)} type="article" math={remarkPluginFrontmatter.math === true}>
  <article>
    <header class="page-head">
      <p class="label">{entry.data.org} · {entry.data.years}</p>
      <h1 class="page-title">{title}</h1>
      <p class="lede">{smart(entry.data.one_liner)}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="More case studies">
    {
      prev ? (
        <a class="prev" href={workHref(prev)} rel="prev">
          <span class="label">Previous</span>
          <span class="t">{smart(prev.data.title)}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="next" href={workHref(next)} rel="next">
          <span class="label">Next</span>
          <span class="t">{smart(next.data.title)}</span>
        </a>
      ) : (
        <a class="next" href="/work/">
          <span class="label">All work</span>
          <span class="t">Back to the list</span>
        </a>
      )
    }
  </nav>
</BaseLayout>
